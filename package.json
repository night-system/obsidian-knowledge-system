{
  "name": "obsidian-knowledge-system",
  "version": "0.3.2",
  "description": "配置驱动的 AI 知识系统框架（v0.3.2）：Base URL 端点自动探测（/anthropic 聊天端点 + 根端点模型列表）、错误可复制诊断、AI 聊天视图（原生 fetch 流式，失败自动降级非流式）、内置工具集、测试按钮。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "knowledge-system"
  ],
  "author": "night-system",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
