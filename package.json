{
  "name": "obsidian-knowledge-system",
  "version": "0.1.0",
  "description": "配置驱动的 AI 知识系统框架（第一阶段 MVP）：DeepSeek 一键配置、自动拉取模型、源/输出文件夹、自定义时间属性 + moment 格式、测试命令（统计最近文件数 / 输出最新内容）。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "knowledge-system"
  ],
  "author": "night-system",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
